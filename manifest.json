{
  "manifest_version": 3,
  "name": "github-utils",
  "version": "1.12.1",
  "description": "Small utilities for GitHub issue and PR lists: ids in front of titles, label-based columns, sorting and filtering, and less clutter.",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
